DEEPSEEK_API_KEY=
CONTEXT7_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=123456789
# Modelo dedicado do coder (ReMax). Obrigatório: var ausente derruba o gateway no load.
CODER_AGENT_MODEL=anthropic/claude-opus-5
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
NODE_VERSION=26
OPENCLAW_STATE_DIR=/app
NPM_CONFIG_LOGLEVEL=info
UV_THREADPOOL_SIZE=16
NODE_ENV=test
OPENCLAW_LOG_LEVEL=debug
OPENCLAW_LOAD_SHELL_ENV=1
NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
OPENCLAW_PROFILE=prod
NODE_COMPILE_CACHE=/tmp
OPENCLAW_NO_RESPAWN=1
OPENCLAW_VERSION=2026.9.1
WHATSAPP_OWNER_NUMBER=+55XXXXXXXXXXX

# Tailscale (opt-in). off = integração inerte (default seguro p/ qualquer clone).
# Para expor o gateway via tailnet: mode=serve (HTTPS tailnet-only) ou funnel (público).
# TAILSCALE_AUTHKEY só é necessário no primeiro boot (state persiste em /app/.tailscale).
GATEWAY_TAILSCALE_MODE=off
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=lzbot
